# ── iOS 内置服务端构建环境：npm run build:mobile:ios ─────────────────────
# App 启动时由内置 Node（nodejs-mobile）在 127.0.0.1 起三个服务，不依赖电脑/局域网。
VITE_KUGOU_API_BASE=http://127.0.0.1:3211
VITE_QQ_API_BASE=http://127.0.0.1:3212
VITE_QISHUI_API_BASE=http://127.0.0.1:3302
VITE_QISHUI_API_TOKEN=

# 网易云暂未内置（本轮只做酷狗 / QQ / 汽水），显式置空避免 .env.local 漏进来。
VITE_NETEASE_API_BASE=
